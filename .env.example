# UY3_AMBIENTE escolhe qual par de credenciais/URLs usar abaixo: "homologacao"
# ou "producao". Equivalente a trocar o environment ativo no Postman.
UY3_AMBIENTE=homologacao

# --- Homologacao (STG) ---
UY3_TOKEN_URL_HOMOLOGACAO=https://bo-credit-unicaii-stg.auth.us-east-2.amazoncognito.com/oauth2/token
UY3_BASE_URL_HOMOLOGACAO=https://web-credit-api.azurewebsites.net
# basic_auth = client_id:client_secret em Base64 (mesmo valor usado no Postman)
UY3_BASIC_AUTH_HOMOLOGACAO=

# --- Producao ---
UY3_TOKEN_URL_PRODUCAO=https://backoffice-unicaii.auth.sa-east-1.amazoncognito.com/oauth2/token
UY3_BASE_URL_PRODUCAO=https://api.uy3.com.br
UY3_BASIC_AUTH_PRODUCAO=

UY3_SCOPE=credit/api_unicaii

# Janela de dias consultada a cada ciclo (o endpoint OffersRequest filtra so
# por dia, formato yyyy-MM-dd - nao aceita hora).
UY3_JANELA_DIAS_CONSULTA=1

# Schema da resposta do OffersRequest CONFIRMADO com dados reais de producao
# (ver docs/Diagnostico_403_AuctionQuery.md) - os nomes de campo estao
# hardcoded em src/data_treatment.py, nao ha mais UY3_CAMPO_* aqui.

# --- Nova Vida (Plataforma Ipe) ---
NOVAVIDA_USER=
NOVAVIDA_PASS=
NOVAVIDA_EMPRESA=
NOVAVIDA_URL=

# NOVAVIDA_CAMPANHA e usada como fallback quando o robo roda com
# permitir_criar_campanha=False (padrao)
NOVAVIDA_CAMPANHA=
NOVAVIDA_PROCESSO=

# --- Regras de negocio / filtros ---
VALOR_MIN=4001.00
VALOR_MAX=8000.99
# Limiar de elegibilidade (Valor Liberado > este valor), por ambiente:
#   - PRODUCAO: mantido em 4000.00 (herdado do processo Astor Tech). Nos
#     primeiros dados reais do OffersRequest, o Valor Liberado tipico ficou
#     entre ~R$175 e ~R$2.100 - este limiar tende a zerar quase toda
#     extracao real. Reveja com o negocio (ver docs/Diagnostico_403_AuctionQuery.md).
#   - HOMOLOGACAO: 0.00 (sem filtro de valor) - so para testar o pipeline.
VALOR_MINIMO_REGRA_NEGOCIO_PRODUCAO=4000.00
VALOR_MINIMO_REGRA_NEGOCIO_HOMOLOGACAO=0.00
INTERVALO_HORAS=1

# --- E-mail (envio via Outlook Web, ver src/notificacao.py) ---
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_REMETENTE=
EMAIL_SENHA=
EMAIL_DESTINATARIO=cs@unicapromotora.com.br
